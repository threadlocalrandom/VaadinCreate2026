<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.runtime</groupId>
        <artifactId>vidocq-runtime-parent</artifactId>
        <version>0.4.0-RC1</version>
    </parent>

    <groupId>org.tlr</groupId>
    <artifactId>vaadin-create-2026</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <vaadin.version>25.3.3</vaadin.version>
        <vaadin.productionMode>true</vaadin.productionMode>
        <vidocq.app.layer>all</vidocq.app.layer>
        <vidocq.mainModule>org.tlr</vidocq.mainModule>
        <!-- Vaadin reads production mode only as a system property of the running JVM:
             these pass it under vidocq:dev, vidocq:run and in the vidocq:package launch scripts. -->
        <vidocq.dev.jvmArgs>-Dvaadin.productionMode=true</vidocq.dev.jvmArgs>
        <vidocq.run.jvmArgs>-Dvaadin.productionMode=true</vidocq.run.jvmArgs>
        <vidocq.jvmArgs>-Dvaadin.productionMode=true</vidocq.jvmArgs>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.runtime</groupId>
            <artifactId>vidocq-runtime-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-foy-servlet-extension</artifactId>
        </dependency>
        <!-- AppShell is looked up through ServiceLoader from flow.server: in a jlink image, only this extension
             lets it (BUG-20261023-06). It changes nothing under vidocq:dev, vidocq:run or vidocq:package. -->
        <dependency>
            <groupId>io.vidocq.runtime.extensions.jakartaee.web</groupId>
            <artifactId>vidocq-runtime-vaadin-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-lumo-theme</artifactId>
        </dependency>
        <!-- The precompiled frontend of the core components: production mode without Node. -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-prod-bundle</artifactId>
            <version>${vaadin.version}</version>
        </dependency>
        <!-- Vaadin logs through SLF4J: without a provider it is silent. This one writes to java.util.logging. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>2.0.17</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-frontend</id>
                        <goals>
                            <goal>prepare-frontend</goal>
                        </goals>
                    </execution>
                    <!-- Bound to process-classes, not the default prepare-package: vidocq:run and vidocq:dev never reach
                         prepare-package, so from an empty target/ they would have no frontend bundle. -->
                    <execution>
                        <id>build-frontend</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>build-frontend</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.vidocq.runtime</groupId>
                <artifactId>vidocq-runtime-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn -Pjlink clean package vidocq:jlink : a self-contained image with its own JDK. -->
        <profile>
            <id>jlink</id>
            <properties>
                <!-- flow-server and flow-react share com/vaadin/flow/server/frontend/, a split package jlink
                     refuses: move those files into one module of the image. -->
                <vidocq.jlink.mergeSharedResources>true</vidocq.jlink.mergeSharedResources>
                <!-- flow-server's Lookup calls ServiceLoader for types of modules that require it: no legal
                     descriptor exists. Patch it anyway; Collaboration Engine and LitTemplate then cannot be used. -->
                <vauban.modularize.forceExplicit>true</vauban.modularize.forceExplicit>
            </properties>
            <build>
                <plugins>
                    <!-- jlink accepts named modules only, and no Vaadin jar is one. The parent manages the version. -->
                    <plugin>
                        <groupId>io.vidocq.vauban</groupId>
                        <artifactId>vauban-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>modularize</id>
                                <goals>
                                    <goal>modularize</goal>
                                </goals>
                                <configuration>
                                    <mode>all-automatic</mode>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>